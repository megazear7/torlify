{
  "name": "torlify",
  "version": "0.0.1",
  "description": "A book making app",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "run-s build serve",
    "serve": "run-p serve:api watch",
    "serve:api": "nodemon dist/server/index.js",
    "watch": "run-p watch:tsc watch:rollup",
    "watch:rollup": "rollup -c --watch",
    "watch:tsc": "tsc --watch",
    "build": "run-s build:tsc build:rollup",
    "build:rollup": "rollup -c",
    "build:tsc": "tsc",
    "lint": "prettier src --check && eslint src",
    "fix": "prettier src --write && eslint src --fix"
  },
  "keywords": [
    "book",
    "ai",
    "author"
  ],
  "author": "Alex Lockhart",
  "license": "UNLICENSED",
  "dependencies": {
    "@lit/context": "^1.1.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lit": "^3.3.1",
    "openai": "^6.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.2",
    "eslint": "^9.39.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rollup": "^4.52.5",
    "tslib": "^2.8.1",
    "typescript-eslint": "^8.46.2"
  }
}
